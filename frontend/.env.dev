# Task Manager frontend — DEV environment
#
# Loaded into the image at build time when `APP_ENV=dev`.
# CRA inlines REACT_APP_* vars at compile time. The Dockerfile copies
# this file to `.env`, then `npm start`/`npm run build` reads it.
# Build args from compose still override (for example,
# REACT_APP_API_URL is overridden in the prod compose).

REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENV=dev
