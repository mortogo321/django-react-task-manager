# Task Manager backend — PRODUCTION environment
#
# Loaded into the image at build time when `APP_ENV=prod`.
# **Real secrets are NOT stored here.** Sensitive values
# (`DJANGO_SECRET_KEY`, `POSTGRES_PASSWORD`, `ANTHROPIC_API_KEY`) are
# injected at deploy time by the CI runtime — compose uses
# `${VAR:?...}` placeholders that fail-fast if the CI env is missing
# them. The placeholder values below exist only so the file is
# self-documenting and the build stays deterministic.

# --- Django ---
DEBUG=False
DJANGO_SECRET_KEY=replace-me-from-ci-secret
ALLOWED_HOSTS=api.baantask.app
CORS_ALLOWED_ORIGINS=https://app.baantask.app

# --- Database ---
POSTGRES_DB=baantask
POSTGRES_USER=baantask
POSTGRES_PASSWORD=replace-me-from-ci-secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Throttling ---
THROTTLE_ANON=60/min
THROTTLE_EMPLOYER=600/min

# --- Translation (Day 4) ---
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-haiku-4-5-20251001
TRANSLATION_CACHE_TTL=604800
TRANSLATION_TIMEOUT=10

# --- TLS ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
