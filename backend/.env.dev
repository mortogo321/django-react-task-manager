# BaanTask backend — DEV environment
#
# Loaded into the image at build time when `APP_ENV=dev` (the default).
# Loose secrets are fine — none of these are real credentials.

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-only-do-not-use-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
POSTGRES_DB=baantask
POSTGRES_USER=baantask
POSTGRES_PASSWORD=baantask_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=0

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Throttling ---
THROTTLE_ANON=120/min
THROTTLE_EMPLOYER=1200/min

# --- Seeding (dev only) ---
# start.sh refuses to seed when APP_ENV=prod, even if this is set to 1.
SEED_DATA=1

# --- Translation (Day 4) ---
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-haiku-4-5-20251001
TRANSLATION_CACHE_TTL=604800
TRANSLATION_TIMEOUT=10
