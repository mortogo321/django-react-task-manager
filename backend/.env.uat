# BaanTask backend — UAT environment
#
# Loaded into the image at build time when `APP_ENV=uat`.
# **Real secrets are NOT stored here** — sensitive values are
# injected at deploy time by the CI runtime (compose `${VAR:?...}`
# placeholders override these). The defaults below exist only as a
# fallback for non-secret config so the build is deterministic.

# --- Django ---
DEBUG=False
DJANGO_SECRET_KEY=replace-me-from-ci-secret
ALLOWED_HOSTS=uat.baantask.app
CORS_ALLOWED_ORIGINS=https://uat-app.baantask.app

# --- Database ---
POSTGRES_DB=baantask_uat
POSTGRES_USER=baantask
POSTGRES_PASSWORD=replace-me-from-ci-secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Throttling ---
THROTTLE_ANON=60/min
THROTTLE_EMPLOYER=600/min

# --- Translation (Day 4) ---
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-haiku-4-5-20251001
TRANSLATION_CACHE_TTL=604800
TRANSLATION_TIMEOUT=10

# --- TLS ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
